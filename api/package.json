{
  "name": "ethiopialearn-api",
  "private": true,
  "version": "0.1.0",
  "description": "EthiopiaLearn backend \u2014 API gateway + microservices (pnpm workspace)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "jest",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter @ethiopialearn/auth-service seed",
    "db:check": "turbo run build --output-logs=errors-only && node scripts/db-check.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/jest": "^30.0.0",
    "eslint": "^9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "turbo": "^2.0.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22"
  }
}
