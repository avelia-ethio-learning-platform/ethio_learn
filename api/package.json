{
  "name": "ethiopialearn-api",
  "private": true,
  "version": "0.1.0",
  "description": "EthiopiaLearn backend — API gateway + microservices (pnpm workspace)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "jest",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter @ethiopialearn/auth-service seed",
    "db:check": "turbo run build --output-logs=errors-only && node scripts/db-check.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/jest": "^30.0.0",
    "eslint": "^9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.7",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "body-parser@1": "^1.20.6",
      "brace-expansion@2": "^2.1.7",
      "multer@2": "^2.3.0",
      "nanoid@3": "^3.3.18",
      "proxy-addr@2": "^2.0.8",
      "qs@6": "^6.16.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  }
}
