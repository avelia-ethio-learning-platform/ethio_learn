# ---- shared ----
NODE_ENV=development
# Port 55432: docker-compose maps host 55432 → container 5432 (avoids clashing
# with a system PostgreSQL on the default port).
DATABASE_URL=postgres://ethiopialearn:ethiopialearn@localhost:55432/ethiopialearn
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT access tokens (15 min TTL) — MUST be long & random in production
JWT_SECRET=dev-jwt-secret-change-me
# Certificate uid signing (tamper resistance); falls back to JWT_SECRET
CERT_SIGNING_SECRET=dev-cert-secret-change-me
# Shared token for service-to-service reads through the gateway
INTERNAL_API_TOKEN=dev-internal-token-change-me

# ---- URLs ----
WEB_URL=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:4000
GATEWAY_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/ethiopialearn

# ---- service addresses (used by the gateway ONLY — see docs/DEPLOYMENT.md) ----
# Services are located only by the gateway; deploy each anywhere and point
# these at it. Defaults suit single-machine dev.
#AUTH_SERVICE_URL=http://localhost:4101
#COURSE_SERVICE_URL=http://localhost:4102
#ENROLLMENT_SERVICE_URL=http://localhost:4103
#OUTCOMES_SERVICE_URL=http://localhost:4104
#FINANCIAL_SERVICE_URL=http://localhost:4105
#QUALITY_SERVICE_URL=http://localhost:4106
#NOTIFICATION_SERVICE_URL=http://localhost:4107

# ---- object storage (MinIO locally; leave S3_ENDPOINT unset on real AWS) ----
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ethiopialearn
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Chapa payments ----
# Mock by default: a local checkout page exercises the full HMAC-webhook path
# offline. For REAL payments:
#   1. CHAPA_MODE=live
#   2. CHAPA_SECRET_KEY = your secret key from dashboard.chapa.co (test keys
#      start with CHASECK_TEST-, live keys with CHASECK-). Server-side only.
#   3. CHAPA_WEBHOOK_SECRET = the webhook secret hash you set in the Chapa
#      dashboard (Settings → Webhooks). Webhook URL to register there:
#      <GATEWAY_PUBLIC_URL>/api/v1/payments/webhook/chapa
# Webhooks are the source of truth; the browser redirect grants nothing. If a
# webhook can't reach the machine (e.g. localhost), the return page triggers a
# server-side reconcile that verifies with Chapa's API directly.
CHAPA_MODE=mock
#CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
CHAPA_WEBHOOK_SECRET=dev-webhook-secret
# Chapa rejects customer emails on non-deliverable domains; if a learner's email
# is refused, the checkout retries with this gateway-accepted fallback address.
CHAPA_FALLBACK_EMAIL=ethiopialearn.demo@gmail.com

# ---- Email ----
# Provider auto-selected: SMTP if SMTP_HOST is set, else Resend if RESEND_API_KEY
# is set, else a dev console logger (prints the email + verification link to the
# notification-service logs). Set ONE of the two below to actually send email.
EMAIL_FROM="EthiopiaLearn <no-reply@ethiopialearn.et>"
PLATFORM_ADMIN_EMAIL=admin@ethiopialearn.et
# Where the Help & Support contact form is delivered (Reply-To is the sender).
SUPPORT_EMAIL=aisubyazew@gmail.com
# --- Option A: SMTP (works with Gmail app-passwords, Mailtrap, any SMTP server) ---
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-app-password
# --- Option B: Resend ---
#RESEND_API_KEY=re_xxxx

# ---- Google sign-in (OAuth2) ----
# Optional. When unset, the "Continue with Google" button simply doesn't appear
# and email/password login works as normal. To enable it:
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client
#      ID → type "Web application".
#   2. Authorised JavaScript origins: your web origin(s), e.g.
#      http://localhost:3000  and  https://yourdomain.com
#   3. Copy the Client ID here AND into the web app as NEXT_PUBLIC_GOOGLE_CLIENT_ID
#      (see web/.env.example). The backend verifies Google ID tokens against it.
# The client secret is NOT needed for this ID-token flow, but keep it if you add
# a server-side redirect flow later.
GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ---- Groq AI (viva grading, quiz generation, course-structure generation, plagiarism) ----
# Get a free key at https://console.groq.com/keys — replace the placeholder below.
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# ---- business config (spec §14 open questions) ----
KYC_PAYOUT_THRESHOLD_ETB=10000
SEED_PASSWORD=Password123!

# ---- gateway rate limits (requests/minute; sensible defaults if unset) ----
# Keyed per authenticated user (falls back to IP); credential endpoints are
# always keyed per IP. See api/gateway/src/rate-policy.ts for the buckets.
#RATE_LIMIT_PER_MIN=300            # everything (always applied)
#RATE_LIMIT_AUTH_STRICT_PER_MIN=10 # login/signup/reset/verify (brute force)
#RATE_LIMIT_AUTH_PER_MIN=30        # rest of /auth (refresh, ...)
#RATE_LIMIT_AI_PER_MIN=5           # LLM-backed endpoints (expensive)
#RATE_LIMIT_COMMUNITY_PER_MIN=20   # comment/DM writes (spam)
#RATE_LIMIT_PAYMENT_PER_MIN=10     # payment initiation
#RATE_LIMIT_WRITE_PER_MIN=60       # any other mutation
