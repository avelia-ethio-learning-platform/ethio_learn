# EthiopiaLearn web (Next.js) — public env vars.
# NEXT_PUBLIC_* are baked in at BUILD time, so set them before `pnpm build`
# (or as docker build-args). They are visible in the browser by design — never
# put secrets here.

# Gateway (API) base URL the browser calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# This site's own public URL (used for canonical links, sitemap, SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL for object storage (thumbnails etc.).
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/ethiopialearn

# Google sign-in: the OAuth Web client ID from Google Cloud Console. Must match
# GOOGLE_CLIENT_ID on the backend. Leave empty to hide the Google button.
# Add your web origin to the client's "Authorised JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Free-tier wake-up: comma-separated public /health URLs (the gateway and the
# seven services on Render). When the browser meets a sleeping service it pings
# these, at most once a minute, to wake them. Leave empty locally and in CI.
NEXT_PUBLIC_WAKE_URLS=

# Object-storage origins the browser talks to directly: presigned uploads and
# signed video URLs (on R2, https://<account-id>.r2.cloudflarestorage.com).
# Comma-separated; they go into the Content Security Policy. Unset, the
# storage public URL's origin is used, which covers local MinIO.
NEXT_PUBLIC_MEDIA_ORIGINS=

# Content Security Policy mode, read at build time. Unset: enforced everywhere
# except Vercel production, where it is Report-Only (violations are logged by
# /api/csp-report and shown in the browser console). Set true to enforce there
# once a console check of the production pages shows no violations.
CSP_ENFORCE=

# Server-side only (server components, ISR): the gateway address the Next server
# calls. Defaults to NEXT_PUBLIC_API_URL; set it when the server can reach the
# gateway on a private address.
#GATEWAY_INTERNAL_URL=http://localhost:4000
